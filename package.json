{
  "name": "weibo-checkin-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "node scripts/extension.mjs",
    "predeploy:local": "node scripts/extension.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:local": "wrangler deploy --config wrangler.local.jsonc",
    "check": "tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none test/*.test.ts",
    "build": "node scripts/extension.mjs && wrangler deploy --dry-run --outdir dist"
  },
  "overrides": {
    "undici": "^7.30.1",
    "basic-ftp": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "^24.0.0",
    "gsap": "3.15.0",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0"
  }
}
